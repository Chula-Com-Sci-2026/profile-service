# Copy this to .env — `cp .env.example .env` — and it will work against `docker compose up -d
# postgres minio create-bucket rabbitmq create-broker-user`. Nothing here is read in production; these are development
# values, including the credentials.
#
# The service checks all of this at startup and refuses to run if anything is wrong, naming
# every problem at once rather than one per restart.

# ─── required ────────────────────────────────────────────────────────────────
# Without any one of these the service will not start.

DATABASE_URL=postgres://profile:profile@localhost:5432/profile

# The secret Identity signs access tokens with — HS256, one secret shared by every service that
# checks them (ADR-0022). Each request's bearer token is verified with it here, locally, never
# trusted because a gateway passed it along. This is Identity's own development value (its
# config.env.example), so a token a local Identity signs verifies here. Never commit a real one.
ACCESS_TOKEN_SECRET=replace-with-local-access-signing-secret

# Object storage for photos — MinIO here, any S3-compatible service in production.
#
# The two endpoints are not redundant. ENDPOINT is how this service reaches storage;
# PUBLIC_ENDPOINT is how a browser does. A presigned upload URL is signed over its host, so a URL
# signed with the internal name is one nobody outside the network can use, and rewriting the host
# afterwards breaks the signature. They are identical below only because both run on your laptop.
# Inside docker compose they are not:
#     OBJECT_STORAGE_ENDPOINT=http://minio:9000
#     OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Created by the `create-bucket` service in docker compose. Named for the service rather than for
# what is in it, because photo keys already start with `photos/`.
OBJECT_STORAGE_BUCKET=profile-service
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# RabbitMQ, where profile events go: required while EVENT_SENDER (below) is rabbitmq, as it is
# here, and not read at all under EVENT_SENDER=none. `docker compose up -d rabbitmq
# create-broker-user` provides them. Profile is its own broker user, `profile`, allowed to declare
# and write the `cra.events` exchange and nothing else.
RABBITMQ_HOST=localhost
RABBITMQ_USER=profile
RABBITMQ_PASSWORD=profile

# ─── optional ────────────────────────────────────────────────────────────────
# Each has a default. Delete any of them and the service still starts.

# default: development
NODE_ENV=development

# default: 3000
PORT=3000

# default: info. One of trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info

# default: cant-run-alone-local. The `iss` every token must carry: Identity's JWT_ISSUER.
JWT_ISSUER=cant-run-alone-local

# default: cant-run-alone-services. The `aud` every token must carry: Identity's JWT_AUDIENCE,
# one audience for every service.
JWT_AUDIENCE=cant-run-alone-services

# default: 0. How long /ready answers 503 while still accepting, so whatever routes traffic has
# time to notice before the server closes. Zero is right on a laptop, where nothing is watching;
# set a few seconds anywhere that routes on /ready. Whatever runs the container must allow for
# this plus ten seconds — `docker stop -t`, or terminationGracePeriodSeconds.
SHUTDOWN_DRAIN_MS=0

# default: 300. How long a presigned photo upload URL stays valid. Long enough to upload a
# photo, short enough that a leaked URL stops working.
OBJECT_STORAGE_UPLOAD_EXPIRES_SECONDS=300

# default: none — every change still writes its ProfileUpdated to the outbox, and it waits there.
# rabbitmq sends the outbox to the RabbitMQ above, every two seconds, oldest first. RabbitMQ being
# down costs only delivery: the service starts without it, and the events wait until it is back.
EVENT_SENDER=rabbitmq

# default: 5672.
RABBITMQ_PORT=5672

# default: /. The RabbitMQ virtual host.
RABBITMQ_VHOST=/
