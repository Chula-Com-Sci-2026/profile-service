DATABASE_URL=postgres://profile:profile@localhost:5432/profile
NODE_ENV=development
PORT=3000

# Identity Service's JWKS endpoint — phase 4 verifies bearer tokens against it
IDENTITY_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Identity's `iss` claim. Checked on every token: the signature already binds a token to
# Identity's keys, and this is the second lock on the same door.
IDENTITY_ISSUER=http://localhost:4000

# pino's level. `silent` under test; `info` if unset.
LOG_LEVEL=info

# How long /ready answers 503 before the server stops accepting, so a load balancer
# notices. 0 in development; a few seconds wherever something routes on /ready.
SHUTDOWN_DRAIN_MS=0

# Object storage for avatars — MinIO in development, any S3 API in production.
# ENDPOINT is how this service reaches it; PUBLIC_ENDPOINT is how a browser does. A presigned
# URL is signed over its host, so the two cannot be collapsed into one.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=profile-service
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_UPLOAD_EXPIRES_SECONDS=300
