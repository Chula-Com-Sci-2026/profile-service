# Copy this to .env — `cp .env.example .env` — and it will work against `docker compose up -d
# postgres minio create-bucket`. Nothing here is read in production; these are development
# values, including the credentials.
#
# The service checks all of this at startup and refuses to run if anything is wrong, naming
# every problem at once rather than one per restart.

# ─── required ────────────────────────────────────────────────────────────────
# Without any one of these the service will not start.

DATABASE_URL=postgres://profile:profile@localhost:5432/profile

# Where the Identity Service publishes its public keys. Every bearer token is verified against
# them locally, on every request — never trusted because a gateway passed it along.
IDENTITY_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Identity's `iss` claim, checked on every token. The signature already ties a token to
# Identity's keys; this is the second lock on the same door.
IDENTITY_ISSUER=http://localhost:4000

# Object storage for avatars — MinIO here, any S3-compatible service in production.
#
# The two endpoints are not redundant. ENDPOINT is how this service reaches storage;
# PUBLIC_ENDPOINT is how a browser does. A presigned upload URL is signed over its host, so a URL
# signed with the internal name is one nobody outside the network can use, and rewriting the host
# afterwards breaks the signature. They are identical below only because both run on your laptop.
# Inside docker compose they are not:
#     OBJECT_STORAGE_ENDPOINT=http://minio:9000
#     OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Created by the `create-bucket` service in docker compose. Named for the service rather than for
# what is in it, because avatar keys already start with `avatars/`.
OBJECT_STORAGE_BUCKET=profile-service
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# ─── optional ────────────────────────────────────────────────────────────────
# Each has a default. Delete any of them and the service still starts.

# default: development
NODE_ENV=development

# default: 3000
PORT=3000

# default: info. One of trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info

# default: 0. How long /ready answers 503 while still accepting, so whatever routes traffic has
# time to notice before the server closes. Zero is right on a laptop, where nothing is watching;
# set a few seconds anywhere that routes on /ready. Whatever runs the container must allow for
# this plus ten seconds — `docker stop -t`, or terminationGracePeriodSeconds.
SHUTDOWN_DRAIN_MS=0

# default: 300. How long a presigned avatar upload URL stays valid. Long enough to upload a
# photo, short enough that a leaked URL stops working.
OBJECT_STORAGE_UPLOAD_EXPIRES_SECONDS=300
