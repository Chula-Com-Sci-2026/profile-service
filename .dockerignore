# .env first, and deliberately: without it the build context carries your credentials into
# the image, which is a leak rather than a size problem.
.env
.env.*
!.env.example

node_modules
dist
.git
.gitignore

# Not needed to build or run the service.
tests
docs
# …except the contract, which /docs and /openapi.yaml serve at runtime.
!docs/openapi.yaml
scripts
coverage
route.rest
.claude
eslint.config.js
vitest.config.ts
vitest.int.config.ts
drizzle.config.ts
